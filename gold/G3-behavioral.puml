@startuml behavioral
title OrderMan - Behavioral Model Gold (G3)

<style>
activity {
  .obj {
    RoundCorner 0
    BackgroundColor #FFFFFF
  }
}
</style>

|Customer|
start
:Make an Order;
:Order [submitted]; <<obj>>

|OrderStaff|
:Receive order;
:Order [pending]; <<obj>>
if () then ([accepted])
  :Fill Order;
  :Order [filled]; <<obj>>
  fork
    :Ship Order;
    :Order [shipped]; <<obj>>
  fork again
    |Accountant|
    :Send Invoice;
    :Invoice [issued]; <<obj>>
    |Customer|
    :Make Payment;
    :Payment [pending]; <<obj>>
    |Accountant|
    while () is ([declined])
      :Reject Payment;
      :Payment [failed]; <<obj>>
      |Customer|
      :Make Payment;
      :Payment [pending]; <<obj>>
      |Accountant|
    endwhile ([authorized])
    :Accept Payment;
    split
      :Payment [completed]; <<obj>>
      detach
    split again
      :Invoice [paid]; <<obj>>
    end split
  end fork
  |OrderStaff|
else ([declined])
endif
:Close Order;
split
  :Order [closed]; <<obj>>
  detach
split again
  stop
end split
@enduml

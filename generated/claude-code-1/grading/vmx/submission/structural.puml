@startuml structural
enum OrderStatus {
  submitted
  pending
  filled
  shipped
  closed
}
enum InvoiceStatus {
  issued
  paid
}
enum PaymentStatus {
  pending
  completed
  failed
}
enum PaymentMethod {
  bank
  card
  cash
}
class Customer {
  name : String
  address : String
  phone : String
  bankAccount : String [0..1]
}
class Product {
  name : String
  description : String
  price : Decimal
  image : Byte[]
}
class Order {
  orderDate : Date
  totalAmount : Decimal
  status : OrderStatus
  paymentMethod : PaymentMethod
}
class OrderItem {
  quantity : Integer
  unitPrice : Decimal
}
class Invoice {
  date : Date
  amount : Decimal
  status : InvoiceStatus
  paymentMethod : PaymentMethod
}
class Payment {
  date : Date
  amount : Decimal
  status : PaymentStatus
  paymentMethod : PaymentMethod
}
Customer "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
OrderItem "0..*" --> "1" Product : refers to
Order "1" -- "0..1" Invoice : is billed by
Invoice "1" -- "0..*" Payment : is settled by
@enduml

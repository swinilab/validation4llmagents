@startuml structural

' Enumerations
enum OrderStatus {
    submitted
    pending
    filled
    shipped
    closed
}
enum InvoiceStatus {
    issued
    paid
}
enum PaymentStatus {
    pending
    completed
    failed
}
enum PaymentMethod {
    bank
    card
    cash
}

' Domain classes
class Customer {
    +name: String
    +address: String
    +phone: String
    +bankAccount: BankAccount [0..1]
}
class BankAccount {
    +accountNumber: String
}
class Product {
    +name: String
    +description: String
    +price: Decimal
    +imageUrl: String
}
class Order {
    +orderDate: Date
    +totalAmount: Decimal
    +status: OrderStatus
    +paymentMethod: PaymentMethod
}
class OrderItem {
    +quantity: Integer
    +unitPrice: Decimal
}
class Invoice {
    +date: Date
    +amount: Decimal
    +status: InvoiceStatus
    +paymentMethod: PaymentMethod
}
class Payment {
    +date: Date
    +amount: Decimal
    +status: PaymentStatus
    +paymentMethod: PaymentMethod
}

' Relationships
Customer "1" --> "0..*" Order : places >
Order "1" *-- "0..*" OrderItem : contains >
OrderItem "1" --> "1" Product : refers to >
Order "0..1" --> "1" Invoice : has >
Invoice "1" *-- "0..*" Payment : records >

@enduml
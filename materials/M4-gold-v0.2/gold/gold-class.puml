@startuml classdiagram
' M4 gold v0.2 — domain class diagram (structural view)
' Class and attribute names are the canonical names of orderman-ontology.yaml v1.0.
' Tier for every element is assigned in gold-tier-map.csv, not here.
skinparam classAttributeIconSize 0

class Customer {
  customer_id : String
  name : String
  email : String
  phone : String
  delivery_address : String
}

class ShoppingCart {
  cart_id : String
  customer_id : String
  created_at : DateTime
  subtotal : Decimal
}

class CartItem {
  cart_item_id : String
  product_id : String
  quantity : Integer
  unit_price : Decimal
}

class Product {
  product_id : String
  name : String
  description : String
  unit_price : Decimal
}

class Inventory {
  product_id : String
  quantity_on_hand : Integer
  quantity_reserved : Integer
  location : String
}

class Order {
  order_id : String
  customer_id : String
  order_date : DateTime
  status : OrderStatus
  total_amount : Decimal
  delivery_address : String
}

enum OrderStatus {
  DRAFT
  PLACED
  PAYMENT_FAILED
  PICKED
  PACKED
  SHIPPED
  CANCELLED
  RETURNED
  REFUNDED
}

class OrderLine {
  order_line_id : String
  order_id : String
  product_id : String
  quantity : Integer
  unit_price : Decimal
  line_total : Decimal
}

class Payment {
  payment_id : String
  order_id : String
  amount : Decimal
  status : String
  authorized_at : DateTime
  gateway_reference : String
}

class Shipment {
  shipment_id : String
  order_id : String
  carrier : String
  tracking_number : String
  shipped_at : DateTime
}

class Carrier {
  carrier_id : String
  name : String
}

class Return {
  return_id : String
  order_id : String
  requested_at : DateTime
  reason : String
  status : String
}

class Refund {
  refund_id : String
  payment_id : String
  amount : Decimal
  issued_at : DateTime
  status : String
}

class AuditLog {
  entry_id : String
  order_id : String
  timestamp : DateTime
  actor_role : String
  prior_state : OrderStatus
  resulting_state : OrderStatus
}

class DailyReport {
  report_date : Date
  total_revenue : Decimal
  shipped_order_count : Integer
}

Customer "1" -- "0..*" Order : places
Customer "1" -- "0..1" ShoppingCart : owns
ShoppingCart "1" *-- "0..*" CartItem : contains
CartItem "0..*" -- "1" Product : refers to
Order "1" *-- "1..*" OrderLine : contains
OrderLine "0..*" -- "1" Product : refers to
Product "1" -- "1" Inventory : stocked as
Order "1" -- "0..*" Payment : paid by
Order "1" *-- "0..*" AuditLog : logs
Order "1" -- "0..1" Return : returned via
Payment "1" -- "0..*" Refund : reversed by
Return "1" -- "0..1" Refund : settled by
Order "1" -- "0..1" Shipment : shipped as
Shipment "0..*" -- "1" Carrier : carried by
@enduml

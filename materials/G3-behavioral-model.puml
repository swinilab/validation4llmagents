@startuml activity
title OrderMan Logical Swimlane

<style>
activity {
  .obj {
    RoundCorner 0
    BackgroundColor #FFFFFF
  }
}
</style>

|Customer|
start
:Make an Order;
:Order; <<obj>>

|OrderStaff|
:Receive order;
:Order [pending]; <<obj>>
if () then ([accepted])
  :Fill Order;
  :Order [filled]; <<obj>>
  fork
    :Ship Order;
    :Order [shipped]; <<obj>>
  fork again
    |Accountant|
    :Send Invoice;
    :Invoice [issued]; <<obj>>
    repeat
      |Customer|
      :Make Payment;
      :Payment [pending]; <<obj>>
      |Accountant|
    backward:Payment [failed]; <<obj>>
    repeat while () is ([declined]) not ([authorized])
    :Accept Payment;
    split
      :Order [paid]; <<obj>>
    split again
      :Payment [completed]; <<obj>>
      detach
    split again
      :Invoice [paid]; <<obj>>
      detach
    end split
  end fork
  |OrderStaff|
else ([declined])
endif
:Close Order;
split
  :Order [closed]; <<obj>>
  detach
split again
  stop
end split
@enduml

@startuml behavioral
title OrderMan - Behavioral Model Gold (G3)

<style>
activity {
  .obj {
    RoundCorner 0
    BackgroundColor #FFFFFF
  }
}
</style>

|Customer|
start
:Make an Order;
:Order [submitted]; <<obj>>

|OrderStaff|
:Receive order;
:Order [pending]; <<obj>>
if () then ([accepted])
  :Fill Order;
  :Order [filled]; <<obj>>
  fork
    :Ship Order;
    :Order [shipped]; <<obj>>
  fork again
    |Accountant|
    :Send Invoice;
    :Invoice [issued]; <<obj>>

    |Customer|
    repeat
      :Make Payment;
      :Payment [pending]; <<obj>>
      |Accountant|
      
     
       backward:Payment [failed]; <<obj>>
    
    repeat while () is ([declined]) not ([authorized])
    
    :Accept Payment;
    if () 
      :Payment [completed]; <<obj>>
      detach
    else ()
      :Invoice [paid]; <<obj>>
    endif
  end fork
  |OrderStaff|
else ([declined])
endif
:Close Order;
split
  :Order [closed]; <<obj>>
  detach
split again
  stop
end split
@enduml
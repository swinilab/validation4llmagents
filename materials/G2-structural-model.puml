@startuml
title OrderMan - Structural Model Gold (G2)
hide circle
skinparam classAttributeIconSize 0

enum OrderStatus {
  pending
  filled
  paid
  shipped
  closed
}

enum InvoiceStatus {
  issued
  paid
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum PaymentMethod {
  bank
  card
  cash
}

class Customer {
  name : String
  address : String
  phone : String
  bankAccount : String [0..1]
}

class Product {
  name : String
  description : String
  price : Decimal
  image : String
}

class Order {
  orderDate : Date
  totalAmount : Decimal
  status : OrderStatus
  method : PaymentMethod
}

class OrderItem {
  quantity : Integer
  unitPrice : Decimal
}

class Invoice {
  date : Date
  amount : Decimal
  status : InvoiceStatus
  method : PaymentMethod
}

class Payment {
  date : Date
  amount : Decimal
  status : PaymentStatus
  method : PaymentMethod
}

Customer "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : consists of
Order "1" -- "0..1" Invoice : billed by
OrderItem "0..*" -- "1" Product : refers to
Invoice "1" -- "0..*" Payment : settled by

Order ..> OrderStatus
Order ..> PaymentMethod
Invoice ..> InvoiceStatus
Invoice ..> PaymentMethod
Payment ..> PaymentStatus
Payment ..> PaymentMethod
@enduml
